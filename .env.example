# HTTP server
PORT=3000
HOST=0.0.0.0

# Caller authentication. Leaving this unset disables caller auth and is unsafe outside local dev.
PROXY_API_KEY=

# ChatGPT/Codex OAuth credentials. Use `npm run build && npm run login` to obtain these.
OPENAI_REFRESH_TOKEN=
OPENAI_ACCESS_TOKEN=
OPENAI_EXPIRES_AT=
OPENAI_CHATGPT_ACCOUNT_ID=
# Optional atomic token-state file. Required to persist rotated refresh tokens across restarts.
OPENAI_TOKEN_FILE=

# Upstream Codex backend. The default URL plus path becomes:
# https://chatgpt.com/backend-api/codex/responses
CODEX_BASE_URL=https://chatgpt.com/backend-api/codex
CODEX_RESPONSES_PATH=/responses

# Comma-separated model ids returned by /v1/models.
CODEX_MODELS=gpt-5.5,gpt-5.5-pro,gpt-5.4,gpt-5.4-mini

# Reliability limits (milliseconds unless noted).
UPSTREAM_CONNECT_TIMEOUT_MS=10000
UPSTREAM_RESPONSE_TIMEOUT_MS=120000
UPSTREAM_IDLE_TIMEOUT_MS=30000
SHUTDOWN_GRACE_MS=30000
HEADERS_TIMEOUT_MS=15000
REQUEST_TIMEOUT_MS=30000
KEEP_ALIVE_TIMEOUT_MS=5000
MAX_CONCURRENT_STREAMS=100
MAX_CONNECTIONS=1000
MAX_REQUEST_BYTES=1000000
